# --------------------------------------------------
# LLM Providers
# --------------------------------------------------

FLEETMIND_GROQ_API_KEY=
FLEETMIND_GEMINI_API_KEY=
FLEETMIND_MISTRAL_API_KEY=

# Optional local fallback
FLEETMIND_ENABLE_OLLAMA=false
FLEETMIND_OLLAMA_HOST=http://localhost:11434

# --------------------------------------------------
# Model IDs
# --------------------------------------------------

FLEETMIND_GROQ_MODEL=openai/gpt-oss-20b
FLEETMIND_GEMINI_MODEL=gemini-3.8-flash
FLEETMIND_MISTRAL_MODEL=mistral-small-2603
FLEETMIND_OLLAMA_MODEL=qwen3:8b

# --------------------------------------------------
# LLM Reliability
# --------------------------------------------------

FLEETMIND_LLM_MAX_ATTEMPTS=2
FLEETMIND_LLM_BACKOFF_SECONDS=0.5
FLEETMIND_LLM_CIRCUIT_FAILURE_THRESHOLD=3
FLEETMIND_LLM_CIRCUIT_COOLDOWN_SECONDS=30
FLEETMIND_LLM_DEFAULT_TIMEOUT_SECONDS=30


POSTGRES_USER=fleetmind
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_DB=fleetmind
POSTGRES_PORT=5432

REDIS_PORT=6379
BACKEND_PORT=8000

FLEETMIND_APP_NAME=FleetMind AI
FLEETMIND_ENVIRONMENT=development
FLEETMIND_LOG_LEVEL=INFO

FLEETMIND_POSTGRES_DSN=postgresql://fleetmind:change_this_local_password@localhost:5432/fleetmind
FLEETMIND_REDIS_URL=redis://localhost:6379/0
FLEETMIND_REDIS_EVENT_STREAM=fleetmind.events